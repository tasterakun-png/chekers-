PORT=3000

# SMTP settings for an email account/service you control.
# Never put these values in public/app.js or commit your real .env file.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
MAIL_FROM="Gmail Checker <no-reply@example.com>"
